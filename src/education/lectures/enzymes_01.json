   "lines": [
    {
     "text": "One last case, because it's the one you'll see in the emergency department.",
     "gesture": "audience"
    },
    {
     "question": "enz_methanol_01",
     "lead": "A man drank windshield-washer fluid."
    },
    {
     "text": "Methanol, and ethylene glycol in antifreeze, are dangerous for what alcohol dehydrogenase turns them into. Block the enzyme and you buy time.",
     "gesture": "audience",
     "reveal": 2
    },
    {
