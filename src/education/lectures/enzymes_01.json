   "slide": {
    "heading": "Summary: enzymes at the bedside",
    "bullets": [
     "Km: affinity; Vmax: capacity",
     "Competitive: ↑Km, same Vmax (statins, fomepizole)",
     "Noncompetitive: ↓Vmax, same Km",
     "PFK-1 controls the pace of glycolysis"
